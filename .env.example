# Bu dosyayı ".env" adıyla kopyala ve kendi anahtarını yaz.
# .env dosyası .gitignore'da: GitHub'a GİTMEZ. Bu örnek dosya ise gider,
# bu yüzden buraya asla gerçek anahtar yazma.

# --- Seçenek 1: Google Gemini (ücretsiz katmanı var) ---
LLM_API_KEY=buraya-anahtarini-yaz
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# --- Seçenek 2: Anthropic Claude ---
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-5-5

# --- Seçenek 3: OpenAI ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=modelin-adi

# --- Seçenek 4: Ollama ile kendi bilgisayarında (anahtar gerekmez) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3

# İsteğe bağlı: maliyet hesabı için 1 milyon token başına USD fiyat.
# Sağlayıcının güncel fiyat sayfasından bakıp yaz; boş bırakırsan maliyet hesaplanmaz.
# LLM_GIRDI_FIYATI=0.30
# LLM_CIKTI_FIYATI=2.50
